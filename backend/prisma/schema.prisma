generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SANTRI
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum ContentStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AudioType {
  LEARNING
  REFERENCE
  RECORDING
  DATASET
}

enum AudioStatus {
  ACTIVE
  ARCHIVED
}

enum TaskType {
  QUIZ
  IMITATION
}

enum EvaluationStatus {
  SUBMITTED
  PROCESSING
  EVALUATED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum FeedbackCategory {
  SANGAT_BAIK
  BAIK
  CUKUP
  PERLU_LATIHAN
}

model User {
  id               String             @id @default(uuid())
  studentId        String?            @unique
  email            String             @unique
  password         String
  name             String
  role             UserRole           @default(SANTRI)
  status           AccountStatus      @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  materialProgress MaterialProgress[]
  taskProgress     TaskProgress[]
  quizAttempts     QuizAttempt[]
  submissions      Submission[]
  reports          Report[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  attempts         Attempt[]
	requestedEvaluationJobs EvaluationJob[] @relation("EvaluationJobRequestedBy")
}

model Stage {
  id          String        @id @default(uuid())
  title       String
  description String?
  order       Int           @unique
  status      ContentStatus @default(DRAFT)
  materials   Material[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Material {
  id              String             @id @default(uuid())
  stageId         String
  title           String
  contentText     String?
  contentImageUrl String?
  order           Int
  isRequired      Boolean            @default(true)
  status          ContentStatus      @default(DRAFT)
  stage           Stage              @relation(fields: [stageId], references: [id])
  audioAssets     MaterialAudio[]
  progress        MaterialProgress[]
  tasks           Task[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([stageId, order])
  @@index([stageId, status])
}

model MaterialAudio {
  materialId String
  audioId    String
  material   Material   @relation(fields: [materialId], references: [id])
  audio      AudioAsset @relation(fields: [audioId], references: [id])

  @@id([materialId, audioId])
}

model AudioAsset {
  id                String          @id @default(uuid())
  type              AudioType
  status            AudioStatus     @default(ACTIVE)
  originalName      String
  objectKey         String          @unique
  mimeType          String
  sizeBytes         Int
  durationSeconds   Float?
  durationMs        Int?
  checksumSha256    String?
  allowLegacyResample Boolean         @default(false)
  version           Int             @default(1)
  archivedFromId    String?
  archivedFrom      AudioAsset?     @relation("AudioVersions", fields: [archivedFromId], references: [id])
  versions          AudioAsset[]    @relation("AudioVersions")
  materialLinks     MaterialAudio[]
  referenceTasks    Task[]          @relation("TaskReferenceAudio")
  questionAudio     Question[]      @relation("QuestionAudio")
  recording         Submission?     @relation("SubmissionRecordingAudio")
  referenceSnapshot Submission[]    @relation("SubmissionReferenceAudio")
  attemptRecordings Attempt[]       @relation("AttemptRecording")
  attemptReferences Attempt[]       @relation("AttemptReference")
  createdAt         DateTime        @default(now())

  @@index([type, status])
  @@index([checksumSha256])
}

model Task {
  id               String         @id @default(uuid())
  stageId          String
  materialId       String?
  title            String
  type             TaskType
  status           ContentStatus  @default(DRAFT)
  order            Int
  referenceAudioId String?
  stage            Stage          @relation(fields: [stageId], references: [id])
  material         Material?      @relation(fields: [materialId], references: [id])
  referenceAudio   AudioAsset?    @relation("TaskReferenceAudio", fields: [referenceAudioId], references: [id])
  questions        Question[]
  progress         TaskProgress[]
  quizAttempts     QuizAttempt[]
  submissions      Submission[]
  attempts         Attempt[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([stageId, order])
  @@index([status, type])
}

model Question {
  id      String         @id @default(uuid())
  taskId  String
  prompt  String
  audioId String?
  order   Int
  task    Task           @relation(fields: [taskId], references: [id])
  audio   AudioAsset?    @relation("QuestionAudio", fields: [audioId], references: [id])
  options AnswerOption[]
  answers QuizAnswer[]
  attemptAnswers AttemptAnswer[]

  @@unique([taskId, order])
}

model AnswerOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  question   Question     @relation(fields: [questionId], references: [id])
  answers    QuizAnswer[]
  attemptAnswers AttemptAnswer[]
}

model QuizAttempt {
  id          String       @id @default(uuid())
  userId      String
  taskId      String
  score       Float
  completedAt DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  task        Task         @relation(fields: [taskId], references: [id])
  answers     QuizAnswer[]

  @@index([userId, taskId, completedAt])
}

model QuizAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  questionId String
  optionId   String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id])
  question   Question     @relation(fields: [questionId], references: [id])
  option     AnswerOption @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
}

model Submission {
  id               String           @id @default(uuid())
  userId           String
  taskId           String
  recordingAudioId String           @unique
  referenceAudioId String?
  status           EvaluationStatus @default(SUBMITTED)
  errorMessage     String?
  submittedAt      DateTime         @default(now())
  processedAt      DateTime?
  user             User             @relation(fields: [userId], references: [id])
  task             Task             @relation(fields: [taskId], references: [id])
  recordingAudio   AudioAsset       @relation("SubmissionRecordingAudio", fields: [recordingAudioId], references: [id])
  referenceAudio   AudioAsset?      @relation("SubmissionReferenceAudio", fields: [referenceAudioId], references: [id])
  evaluation       Evaluation?

  @@index([userId, taskId, status])
}

model Evaluation {
  id           String     @id @default(uuid())
  submissionId String     @unique
  score        Float?
  feedback     String?
  modelVersion String?
  errorMessage String?
  evaluatedAt  DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model MaterialProgress {
  id          String    @id @default(uuid())
  userId      String
  materialId  String
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
  material    Material  @relation(fields: [materialId], references: [id])

  @@unique([userId, materialId])
}

model TaskProgress {
  id             String    @id @default(uuid())
  userId         String
  taskId         String
  completedAt    DateTime?
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  attemptCount   Int       @default(0)
  bestScore      Decimal?  @db.Decimal(5, 2)
  user           User      @relation(fields: [userId], references: [id])
  task           Task      @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
  @@index([userId, completedAt])
  @@index([taskId, bestScore])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  objectKey   String?
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, generatedAt])
}

// SDD v1.0 canonical attempt history. The legacy Submission/QuizAttempt
// models above remain temporarily while services are migrated in the next step.
model Attempt {
  id                  String             @id @default(uuid())
  userId              String
  taskId              String
  taskType            TaskType
  attemptNo           Int
  recordingAudioId    String?
  referenceAudioId    String?
  evaluationStatus    EvaluationStatus?
  score               Decimal?           @db.Decimal(5, 2)
  feedbackCategory    FeedbackCategory?
  correctCount        Int?
  questionCount       Int?
  processingStartedAt DateTime?
  evaluatedAt         DateTime?
  failedAt            DateTime?
  errorCode           String?
  modelVersion        String?
  processingMs        Int?
  submittedAt         DateTime           @default(now())
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  task                Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)
  recordingAudio      AudioAsset?        @relation("AttemptRecording", fields: [recordingAudioId], references: [id], onDelete: Restrict)
  referenceAudio      AudioAsset?        @relation("AttemptReference", fields: [referenceAudioId], references: [id], onDelete: Restrict)
  jobs                EvaluationJob[]
  answers             AttemptAnswer[]

  @@unique([userId, taskId, attemptNo])
  @@index([userId, taskId, evaluationStatus])
  @@index([userId, submittedAt])
  @@index([taskId, evaluationStatus, submittedAt])
  @@index([taskType, evaluationStatus, submittedAt])
  @@map("attempts")
}

// Canonical answer history for Quiz attempts. QuizAnswer remains attached to
// the legacy QuizAttempt model only while old data is retained for rollback.
model AttemptAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  questionId String
  optionId   String
  attempt    Attempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option     AnswerOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([optionId])
  @@map("attempt_answers")
}

model EvaluationJob {
  id            String    @id @default(uuid())
  attemptId     String
  status        JobStatus @default(QUEUED)
  runAfter      DateTime  @default(now())
  runCount      Int       @default(0)
	maxRuns       Int       @default(3)
  startedAt     DateTime?
	lockedAt      DateTime?
	lockedBy      String?
  finishedAt    DateTime?
  lastErrorCode String?
	lastErrorDetail String?
	isRetry       Boolean   @default(false)
	requestedById String?
  createdAt     DateTime  @default(now())
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
	requestedBy   User?     @relation("EvaluationJobRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, runAfter, createdAt])
  @@map("evaluation_jobs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@map("audit_logs")
}

// Object uploaded successfully but left without a committed AudioAsset after
// a failed submit transaction. A scheduled cleanup can safely retry deletion.
model StorageOrphan {
  id              String   @id @default(uuid())
  objectKey       String   @unique
  cleanupReason   String
  lastErrorDetail String?
  createdAt       DateTime @default(now())
  cleanedAt       DateTime?

  @@index([cleanedAt, createdAt])
  @@map("storage_orphans")
}
